# Les hooks sont des scripts shell exécutés par Git Bash : en CRLF, le
# shebang casse (« bad interpreter »). On force LF, quelle que soit la
# configuration autocrlf de la machine.
.githooks/** text eol=lf
*.sh text eol=lf
# Signed fixtures: the bytes under signature must never be re-encoded on checkout (audit lot 4, E12c).
tools/release-verify/fixtures/** -text
