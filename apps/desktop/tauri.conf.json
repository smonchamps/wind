{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wind",
  "version": "0.2.0",
  "identifier": "dev.elements.wind",
  "build": {
    "frontendDist": "ui-v2/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wind",
        "width": 1000,
        "height": 700,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=OverlayScrollbar"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Elements",
    "shortDescription": "Client mail rapide, simple et fiable",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/smonchamps/wind/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMTNDOUY4MTE3RjcwN0YKUldSL2NIOFIrTWtUL09iby9XUlhRTUhZcGtMaXNZbWhKSFhWQTErRDRlcHROV0JLaGdJTWpENGwK"
    }
  }
}