#!/bin/sh
# Pre-push gate: the last rampart before code leaves the machine.
#
# It exists because a hosted GitHub runner CANNOT open a WebView2 window
# (measured: application alive, mute, without CDP — see
# docs/adr/0005-gate-e2e-hors-ci-hebergee.md). The E2E journeys therefore
# only run from here.
#
# What it prevents, concretely: shipping while announcing "tests green"
# without a single real journey having been played. That is exactly what
# let the ignored SMTP port and the permanently displayed add menu through.
#
# Deliberate order: from the fastest to the slowest, to fail early.
#
# Emergency bypass: git push --no-verify (knowingly).
set -e

# Docs-only fast path (PLAN-KAIZEN-CLAUDE wave 2, E4): if EVERYTHING that
# leaves is prose — docs/** or *.md, EXCLUDING docs/design/** (the System
# is tooled normative content, DC-D6: full gate) — the steps 10-13
# (clippy, Rust tests, e2e, ~4 min) can catch nothing: we keep the steps
# measured in seconds (1-9).
# Caution by default: new ref or deletion => full gate.
docs_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) docs_only=0; break ;; esac   # ref deletion
  case "$remote_sha" in *[!0]*) ;; *) docs_only=0; break ;; esac  # new ref
  # A remote_sha unknown locally (rewritten history, shallow clone, remote
  # ahead) killed the hook under `set -e` with "Invalid revision range" —
  # and the push with it (2026-09-01, after git filter-repo). Caution:
  # full gate, not a refusal.
  files=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null) \
    || { docs_only=0; break; }
  [ -n "$files" ] || continue
  # Iterate by LINE (never by word: a path with a space would be split and
  # each fragment classified separately).
  old_ifs=$IFS
  IFS='
'
  for f in $files; do
    case "$f" in
      docs/design/*) docs_only=0 ;;
      docs/*|*.md) ;;
      *) docs_only=0 ;;
    esac
  done
  IFS=$old_ifs
  [ "$docs_only" = 1 ] || break
done

# PLAN-AUDIT-V2 E9 (D-32 settled): ONE gate, `scripts/gate.ps1` — the hook
# no longer copies its commands (two unwanted divergences lived there).
# The docs-only shortcut goes through `-DocsOnly`.
if [ "$docs_only" = 1 ]; then
  echo "Docs-only diff (docs/** + *.md, outside docs/design/**)."
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1 -DocsOnly
else
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1
fi

echo "Pre-push gate complete: the CI should be green."
