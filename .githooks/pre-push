#!/bin/sh
# Gate pré-push : le dernier rempart avant que du code quitte la machine.
#
# Il existe parce qu'un runner GitHub hébergé ne peut PAS ouvrir de fenêtre
# WebView2 (mesuré : application vivante, muette, sans CDP — voir
# docs/adr/0005-gate-e2e-hors-ci-hebergee.md). Les parcours E2E ne tournent
# donc que d'ici.
#
# Ce qu'il empêche, concrètement : livrer en annonçant « tests verts » sans
# qu'un seul parcours réel ait été joué. C'est exactement ce qui a laissé
# passer le port SMTP ignoré et le menu d'ajout affiché en permanence.
#
# Ordre volontaire : du plus rapide au plus lent, pour échouer tôt.
#
# Contournement d'urgence : git push --no-verify (en connaissance de cause).
set -e

# Chemin rapide documentaire (PLAN-KAIZEN-CLAUDE vague 2, E4) : si TOUT
# ce qui part est de la prose — docs/** ou *.md, en EXCLUANT
# docs/design/** (le Système est du normatif outillé, DC-D6 : gate
# entière) — les étapes 6-8 (clippy, tests Rust, e2e, ~4 min) ne
# peuvent rien attraper : on garde les étapes en secondes (1-5).
# Prudence par défaut : ref neuve ou suppression => gate entière.
docs_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) docs_only=0; break ;; esac   # suppression de ref
  case "$remote_sha" in *[!0]*) ;; *) docs_only=0; break ;; esac  # ref neuve
  fichiers=$(git diff --name-only "$remote_sha".."$local_sha")
  [ -n "$fichiers" ] || continue
  # Itération par LIGNE (jamais par mot : un chemin avec espace serait
  # scindé et chaque fragment classé séparément).
  vieux_ifs=$IFS
  IFS='
'
  for f in $fichiers; do
    case "$f" in
      docs/design/*) docs_only=0 ;;
      docs/*|*.md) ;;
      *) docs_only=0 ;;
    esac
  done
  IFS=$vieux_ifs
  [ "$docs_only" = 1 ] || break
done

echo "[1/8] format"
cargo fmt --all -- --check

echo "[2/8] build ui-v2 (Svelte + Vite)"
# Rapide (~3 s) : echoue tot si la refonte ne compile plus. `npm ci`
# n'est PAS rejoue ici — installer une fois, le build suffit ensuite.
(cd apps/desktop/ui-v2 && npm run build)

echo "[3/8] contrastes WCAG (A8)"
# Millisecondes : chaque paire (encre, fond) des 7 themes doit tenir
# 4,5:1 texte / 3:1 composants. Un jeton retouche sous le seuil = stop.
node e2e/contraste.mjs > /dev/null

echo "[4/8] coherence du Systeme (DC-D6)"
# Le Systeme (docs/design/systeme.dc.html) ne doit jamais deriver du
# livre (systeme.css) : la CI le verifie deja, le dernier rempart local
# aussi desormais — un commit UI sans son amendement DC-D2 s'arrete ici.
node e2e/coherence-systeme.mjs > /dev/null

echo "[5/8] garde du thread principal (PLAN-GELS)"
# Millisecondes : une commande Tauri synchrone qui ouvre la base gele la
# fenetre pour toute sa duree (pompe de messages bloquee). Toute commande
# bloquante doit etre `async fn`.
node e2e/garde-thread-principal.mjs > /dev/null

if [ "$docs_only" = 1 ]; then
  echo "Diff documentaire seul (docs/** + *.md, hors docs/design/**) :"
  echo "etapes 6-8 sautees. Gate pre-push documentaire complete."
  exit 0
fi

echo "[6/8] clippy (warnings = erreurs)"
cargo clippy --workspace --all-targets -- -D warnings

echo "[7/8] tests Rust"
# `--all-targets` n'est PAS décoratif : sans lui, cargo ignore les tests
# des EXEMPLES. Or les diagnostics du terrain vivent là (crates/mail-core/
# examples/), et ils portent leurs propres tests — dont celui qui empêche
# un diagnostic de divulguer des identifiants en clair. Constaté : deux
# tests écrits, verts, et jamais exécutés par ce gate.
#
# `--all-targets` exclut en revanche les doc-tests, d'où la seconde ligne.
cargo test --workspace --all-targets
cargo test --workspace --doc

echo "[8/8] E2E — la vraie fenetre pilotee via CDP"
cd e2e
npm test

echo "Gate pré-push complet : la CI devrait être verte."
